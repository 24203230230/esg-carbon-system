# ESG 碳治理能力画像系统 · 命名隧道（长期公网入口）
#
# 用途：把自有域名（如 esg.example.cn）暴露到公网 → 指向 esg-frontend 容器:80
# 启动：docker-compose -f cloudflared-esg-tunnel.yml up -d
#
# ⚠️ 本文件是模板。真实 Tunnel Token 绝不入库：
#      docker-compose -f cloudflared-esg-tunnel.yml.yml 会读取同目录 .env 里的 CF_TUNNEL_TOKEN
#      或在 CI/命令行通过环境变量注入。
#
# 稳定性参数（实测结论，勿随意删改）：
#   --protocol http2     = 走 TCP/443，规避封锁 UDP 出口的网络（QUIC 默认走 UDP，
#                          会报 "Failed to dial a quic connection: timeout"）
#   --edge-ip-version 4  = 无 IPv6 出口时显式只用 IPv4，避免先试 AAAA 白等一轮超时
#   --no-autoupdate      = 版本由镜像控制，避免容器内自更新引入抖动
#   --metrics            = 暴露健康指标端点，配合看门狗使用。
#                          /ready 有活跃边缘连接返 200、无连接返 503 ——
#                          判断"隧道是否真的通了"最可靠的程序化信号
#   dns                  = 显式指定解析器。隧道断线重连必须重新解析
#                          region1.v2.argotunnel.com，宿主 DNS 一挂就再也连不回来

services:
  cloudflared-esg:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared-esg
    restart: unless-stopped
    environment:
      - TUNNEL_TOKEN=${CF_TUNNEL_TOKEN:?CF_TUNNEL_TOKEN is required}
    command: tunnel --no-autoupdate --edge-ip-version 4 --protocol http2 --metrics 0.0.0.0:20241 run
    dns:
      - 223.5.5.5       # 阿里 DNS
      - 180.76.76.76    # 百度 DNS（备份）
    ports:
      # 仅绑宿主机回环，供看门狗查 /ready；不要改成 0.0.0.0 或省略前缀
      - "127.0.0.1:20241:20241"
    networks:
      - ai-network

networks:
  ai-network:
    external: true
