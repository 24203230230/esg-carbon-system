# ===== 敏感信息（绝不入库）=====
.env
*.env.local
*.env.*.local
# 隧道 / 平台密钥的本地实配（仅入库 .example 模板）
deploy/*.secret.yml

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo

# ===== 运行产物 =====
output/
*.log
*.tmp
~$*

# ===== 容器 / 构建产物 =====
*.tgz
*.tar
*.tar.gz

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE =====
.vscode/
.idea/

# ===== 本地开发辅助（性能诊断、版本备份、临时脚本）=====
_perf/
cloudflared-temp/
*.bak
*.bak_*

# ===== 本机运维脚本（含本机绝对路径与私有域名，不入库）=====
#   他人的复现方式见 README「复现与 AI 辅助部署」
stack_ctl.ps1
open_server_ui.cmd

# ===== 本机 PowerShell 重定向产物（UTF-16 乱码，无复现价值）=====
#   真实运行日志见 data/baseline_105/scripts/_recheck/_summary.json
data/baseline_105/scripts/_recheck_*.txt
data/baseline_105/scripts/_recheck_test1.txt
data/baseline_105/**/*_stdout.txt
data/baseline_105/**/*_rc.txt
