# ============================================================================
#  ESG 碳治理能力画像系统 · 环境变量模板
#  用法：cp .env.example .env  然后填入真实值
#  ⚠️ .env 已被 .gitignore 排除，任何密钥都不得入库
# ============================================================================

# ---------------------------------------------------------------------------
# 1. DeepSeek API（智能体一提取 + 智能体二根因分析，复用同一 key）
#    获取：https://platform.deepseek.com
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled = 关闭思维链（提取任务追求稳定 JSON 输出，不需要推理链）
DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# 2. 智能体二后端模式（双轨切换）
#    deepseek = DeepSeek 直调（默认，全自主可控，开源部署零平台配置）
#    adp      = 腾讯云 ADP 工作流（比赛展示用，需下方 ADP_APP_KEY）
# ---------------------------------------------------------------------------
ADP_BACKEND=deepseek

# 仅 ADP_BACKEND=adp 时需要
# AppKey 获取：ADP 控制台 → 应用管理 → 已发布应用 →「调用」→ 复制 AppKey
ADP_APP_KEY=your_adp_appkey_here
# ADP_CHAT_ENDPOINT=https://wss.lke.cloud.tencent.com/adp/v2/chat

# ---------------------------------------------------------------------------
# 3. LLM 网关（one-api · 多模型统一入口，推荐）
#    统一管理 DeepSeek / 智谱 / 月之暗面 / MiniMax 等渠道，
#    前端「分析模型」下拉切模型由网关路由，业务代码不接触各家密钥。
#
#    首次配置：
#      1) 启动 esg-one-api 容器后访问 http://localhost:3001
#      2) 默认登录 root/123456（首次务必改密码）
#      3) 渠道 → 添加渠道：填入各平台真实 API Key
#         ⚠️ 渠道的「模型」字段必须包含底层真实模型名（如 deepseek-chat / deepseek-reasoner）
#      4) 令牌 → 添加令牌：生成分发 token，模型范围要勾全
#      5) 把该 token 填入下方 LLM_GATEWAY_KEY
# ---------------------------------------------------------------------------
LLM_GATEWAY_URL=http://esg-one-api:3000/v1
LLM_GATEWAY_KEY=your_oneapi_distribution_token_here

# ---------------------------------------------------------------------------
# 4. 容器端口（可选，默认即可）
# ---------------------------------------------------------------------------
EXTRACT_PORT=8082

# ---------------------------------------------------------------------------
# 5. 数据准备脚本专用（可选；不跑词频统计 / CSMAR 拉数就无需配置）
# ---------------------------------------------------------------------------
# CNINFO_TOKEN=your_cninfo_token
# CSMAR_DATA_ROOT=D:\data\csmar
# OCR_NUM_THREADS=2
