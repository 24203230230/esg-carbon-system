# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：自定义 API 地址（默认官方）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名称（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：深度思考模式（默认 disabled）
# ⚠️ DeepSeek V4.1 起思考模式默认开启，思维链与 content 共享 max_tokens，
#    会导致 JSON 截断（失败率 3% → 17%）⇒ 提取任务必须显式关闭。
# DEEPSEEK_THINKING=disabled

# ==================== COS 直传（v=114，可选） ====================
# 用途：大报告（实测存在 99.8MB 量级）不经"浏览器 → 服务器"跨境直传，
#       改为浏览器直传对象存储，服务器再从对象存储取件。
# 实测：99.8MB 上传 4.4 分钟 → 约 40 秒。
# ⚠️ 不配这一段 = 自动走原来的 1MB 分片链路，功能完全不受影响（仅慢）。
# ⚠️ 建议用**子账号**密钥，权限只给：该桶的 PutObject / GetObject / DeleteObject。
#    前端拿不到这些密钥 —— 它只从后端换 1 小时有效期的预签名 URL。
COS_ENABLED=0
# COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# COS_BUCKET=your-bucket-1250000000
# COS_REGION=ap-guangzhou
# 前端直传域名（预签名 URL 的 host；前端不得改写 host，否则签名校验失败返回 403）
# COS_UPLOAD_ENDPOINT=cos.accelerate.myqcloud.com
# 服务器取件域名，逗号分隔、按序回退。腾讯云内网的服务器把内网加速域名放第一位最快：
#   cos-internal.accelerate.tencentcos.cn,cos.accelerate.myqcloud.com,cos.<region>.myqcloud.com
# COS_FETCH_ENDPOINTS=cos.accelerate.myqcloud.com
# 对象 key 前缀，同时是取件白名单（后端只允许拉这个前缀下的对象）
# COS_KEY_PREFIX=uploads/
# COS_MAX_UPLOAD_MB=500
# COS_PRESIGN_TTL=3600
# COS_DELETE_AFTER_FETCH=1
