# ===== ESG 碳画像系统 环境变量模板 =====
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）

# --- DeepSeek API（提取引擎）---
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# --- 腾讯云 ADP（智能体根因分析）---
# AppKey 获取：ADP 控制台 → 应用管理 → 已发布应用 → 「调用」→ 复制 AppKey
ADP_APP_KEY=your_adp_appkey_here

# --- 容器端口（可选，默认即可）---
EXTRACT_PORT=8082
