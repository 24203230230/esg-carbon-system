# ===== ESG 碳画像系统 环境变量模板 =====
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）

# --- DeepSeek API（提取引擎 + 智能体二根因分析，复用同一 key）---
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# --- 智能体二后端模式（双轨切换）---
#   deepseek = DeepSeek 直调（默认，全自主可控，开源部署无需任何平台配置）
#   adp      = ADP 工作流（比赛展示·权威平台，需配置下方 ADP_APP_KEY）
ADP_BACKEND=deepseek

# --- 腾讯云 ADP（仅 ADP_BACKEND=adp 时需要）---
# AppKey 获取：ADP 控制台 → 应用管理 → 已发布应用 → 「调用」→ 复制 AppKey
ADP_APP_KEY=your_adp_appkey_here

# --- 容器端口（可选，默认即可）---
EXTRACT_PORT=8082
